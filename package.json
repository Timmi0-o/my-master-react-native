{
  "name": "my-master-react-native",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "i18n:gen": "node scripts/generate-i18n-messages.mjs",
    "i18n:watch": "node scripts/generate-i18n-messages.mjs --watch",
    "i18n:migrate": "node scripts/migrate-locales-to-messages.mjs && npm run i18n:gen",
    "prestart": "npm run i18n:gen",
    "prestart:dev": "npm run i18n:gen",
    "preandroid": "npm run i18n:gen && node scripts/patch-foojay.mjs",
    "preios": "npm run i18n:gen",
    "start": "expo start --go",
    "start:dev": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android --no-bundler",
    "android:full": "expo run:android",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk && adb shell am start -n com.timofey.mymaster/.MainActivity",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.2.2",
    "@huymobile/react-native-iconify": "^1.0.9",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@tanstack/react-query": "^5.100.6",
    "expo": "^56.0.0",
    "expo-blur": "~56.0.3",
    "expo-constants": "~56.0.16",
    "expo-dev-client": "~56.0.18",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.9",
    "expo-image-picker": "~56.0.18",
    "expo-linking": "~56.0.13",
    "expo-localization": "~56.0.6",
    "expo-router": "~56.2.8",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "heroui-native": "^1.0.4",
    "i18next": "^26.3.1",
    "mobx": "^6.15.0",
    "mobx-react": "^9.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.74.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.4",
    "uniwind": "^1.6.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@iconify/react": "^6.0.2",
    "@types/react": "~19.2.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
